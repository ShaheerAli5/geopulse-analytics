node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Next.js Build Outputs & Cache ---
.next/
out/
build/
dist/

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.installed.cfg
*.egg

# --- Python Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Environment Variables & Secrets ---
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# --- Vercel Deployment Artifacts ---
.vercel

# --- Operating System & IDE Files ---
.DS_Store
Thumbs.db
Desktop.ini
